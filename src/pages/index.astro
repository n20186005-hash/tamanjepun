---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import ms from '../content/ms';
import { FACTS } from '../data/site';
import { homeJsonLd } from '../lib/page';
---

<BaseLayout
  locale="ms"
  route="home"
  title={ms.meta.title}
  description={ms.meta.description}
  ogImage={FACTS.images.garden.src}
  preloadImage={FACTS.images.garden.src}
  jsonLd={homeJsonLd(Astro.site, 'ms', ms)}
>
  <HomePage locale="ms" t={ms} />
</BaseLayout>
