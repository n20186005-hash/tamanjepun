---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuidePage from '../../../components/GuidePage.astro';
import zh from '../../../content/zh';
import { FACTS } from '../../../data/site';
import { articleJsonLd } from '../../../lib/page';
---

<BaseLayout
  locale="zh"
  route="tickets"
  title={zh.articles.tickets.title}
  description={zh.articles.tickets.description}
  ogImage={FACTS.images.garden.src}
  jsonLd={articleJsonLd(Astro.site, 'zh', zh, 'tickets')}
>
  <GuidePage locale="zh" t={zh} articleKey="tickets" />
</BaseLayout>
