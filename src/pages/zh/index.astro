---
import BaseLayout from '../../layouts/BaseLayout.astro';
import HomePage from '../../components/HomePage.astro';
import zh from '../../content/zh';
import { FACTS } from '../../data/site';
import { homeJsonLd } from '../../lib/page';
---

<BaseLayout
  locale="zh"
  route="home"
  title={zh.meta.title}
  description={zh.meta.description}
  ogImage={FACTS.images.garden.src}
  preloadImage={FACTS.images.garden.src}
  jsonLd={homeJsonLd(Astro.site, 'zh', zh)}
>
  <HomePage locale="zh" t={zh} />
</BaseLayout>
