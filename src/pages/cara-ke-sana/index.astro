---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GuidePage from '../../components/GuidePage.astro';
import ms from '../../content/ms';
import { FACTS } from '../../data/site';
import { articleJsonLd } from '../../lib/page';
---

<BaseLayout
  locale="ms"
  route="transport"
  title={ms.articles.transport.title}
  description={ms.articles.transport.description}
  ogImage={FACTS.images.colmar.src}
  jsonLd={articleJsonLd(Astro.site, 'ms', ms, 'transport')}
>
  <GuidePage locale="ms" t={ms} articleKey="transport" />
</BaseLayout>
