---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuidePage from '../../../components/GuidePage.astro';
import en from '../../../content/en';
import { FACTS } from '../../../data/site';
import { articleJsonLd } from '../../../lib/page';
---

<BaseLayout
  locale="en"
  route="photos"
  title={en.articles.photos.title}
  description={en.articles.photos.description}
  ogImage={FACTS.images.view.src}
  jsonLd={articleJsonLd(Astro.site, 'en', en, 'photos')}
>
  <GuidePage locale="en" t={en} articleKey="photos" />
</BaseLayout>
