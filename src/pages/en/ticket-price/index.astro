---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuidePage from '../../../components/GuidePage.astro';
import en from '../../../content/en';
import { FACTS } from '../../../data/site';
import { articleJsonLd } from '../../../lib/page';
---

<BaseLayout
  locale="en"
  route="tickets"
  title={en.articles.tickets.title}
  description={en.articles.tickets.description}
  ogImage={FACTS.images.garden.src}
  jsonLd={articleJsonLd(Astro.site, 'en', en, 'tickets')}
>
  <GuidePage locale="en" t={en} articleKey="tickets" />
</BaseLayout>
