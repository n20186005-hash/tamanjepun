---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuidePage from '../../../components/GuidePage.astro';
import en from '../../../content/en';
import { FACTS } from '../../../data/site';
import { articleJsonLd } from '../../../lib/page';
---

<BaseLayout
  locale="en"
  route="transport"
  title={en.articles.transport.title}
  description={en.articles.transport.description}
  ogImage={FACTS.images.colmar.src}
  jsonLd={articleJsonLd(Astro.site, 'en', en, 'transport')}
>
  <GuidePage locale="en" t={en} articleKey="transport" />
</BaseLayout>
