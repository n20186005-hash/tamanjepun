---
import { pathFor, type Locale, type RouteKey } from '../i18n';
import type { Content } from '../content/types';

const { locale, t } = Astro.props as { locale: Locale; t: Content };

const cards = [
  { key: 'tickets' as RouteKey, title: t.articles.tickets.h1, text: t.articles.tickets.description },
  { key: 'transport' as RouteKey, title: t.articles.transport.h1, text: t.articles.transport.description },
  { key: 'photos' as RouteKey, title: t.articles.photos.h1, text: t.articles.photos.description }
];
---

<section class="border-t border-[#17352a]/10 py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[.24em] text-[#a63d2f]">{t.explore.eyebrow}</p>
      <h2 class="serif mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{t.explore.h2}</h2>
      <p class="mt-5 leading-7 text-[#17352a]/70">{t.explore.intro}</p>
    </div>
    <div class="mt-10 grid gap-5 md:grid-cols-3">
      {
        cards.map((card) => (
          <a href={pathFor(card.key, locale)} class="focus-ring group flex flex-col rounded-3xl border border-[#17352a]/10 bg-white p-6 transition hover:-translate-y-0.5 hover:border-[#a63d2f]/40">
            <h3 class="text-xl font-black leading-7">{card.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[#17352a]/66">{card.text}</p>
            <span class="mt-5 text-sm font-black text-[#a63d2f]">{t.explore.more} →</span>
          </a>
        ))
      }
    </div>
  </div>
</section>
