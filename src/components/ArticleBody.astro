---
import { pathFor, type Locale, type RouteKey } from '../i18n';
import type { Article, Content } from '../content/types';

const { locale, t, article } = Astro.props as { locale: Locale; t: Content; article: Article };

const homeHref = pathFor('home', locale);
const related = article.related.map((item) => ({ href: pathFor(item.key as RouteKey, locale), label: item.label }));
---

<main id="atas" class="bg-[#17352a] pt-28 text-white">
  <div class="mx-auto max-w-4xl px-5 pb-16 lg:px-8">
    <nav aria-label={t.labels.breadcrumbHome} class="text-xs font-semibold text-white/60">
      <a class="focus-ring rounded hover:text-[#d8bc7a]" href={homeHref}>{t.labels.breadcrumbHome}</a>
      <span class="px-2 text-white/35">/</span>
      <span class="text-white/80">{article.nav}</span>
    </nav>
    <p class="mt-8 text-xs font-black uppercase tracking-[.24em] text-[#d8bc7a]">{article.eyebrow}</p>
    <h1 class="serif mt-4 text-4xl font-bold leading-tight tracking-tight sm:text-5xl">{article.h1}</h1>
    <p class="mt-6 text-lg leading-8 text-white/82">{article.lede}</p>
  </div>
</main>

<article class="py-14 lg:py-20">
  <div class="mx-auto max-w-4xl px-5 lg:px-8">
    <section class="rounded-[2rem] border border-[#17352a]/10 bg-[#efe8da] p-6 sm:p-8">
      <h2 class="text-xs font-black uppercase tracking-[.2em] text-[#a63d2f]">{article.factsTitle}</h2>
      <dl class="mt-5 divide-y divide-[#17352a]/10 text-sm">
        {
          article.facts.map((row) => (
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt class="font-bold">{row.label}</dt>
              <dd class="text-right text-[#17352a]/70">{row.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>

    {
      article.sections.map((section) => (
        <section class="mt-12">
          <h2 class="serif text-3xl font-bold tracking-tight sm:text-4xl">{section.h2}</h2>
          {section.paras.map((p) => <p class="mt-5 leading-8 text-[#17352a]/78">{p}</p>)}
          {section.bullets ? (
            <ul class="mt-5 space-y-2 rounded-[1.5rem] border border-[#17352a]/10 bg-white p-6 text-sm leading-7 text-[#17352a]/70">
              {section.bullets.map((b) => <li>• {b}</li>)}
            </ul>
          ) : null}
        </section>
      ))
    }

    <section class="mt-14">
      <h2 class="serif text-3xl font-bold tracking-tight sm:text-4xl">{t.faq.h2}</h2>
      <div class="mt-6 space-y-3">
        {
          article.faq.map((item) => (
            <details class="group rounded-2xl border border-[#17352a]/10 bg-white p-5 open:card-shadow">
              <summary class="cursor-pointer list-none pr-8 font-black marker:hidden">
                {item.q}<span class="float-right text-[#a63d2f] transition group-open:rotate-45">＋</span>
              </summary>
              <p class="mt-4 max-w-3xl text-sm leading-7 text-[#17352a]/68">{item.a}</p>
            </details>
          ))
        }
      </div>
    </section>

    <section class="mt-14 border-t border-[#17352a]/10 pt-8">
      <h2 class="text-xs font-black uppercase tracking-[.2em] text-[#a63d2f]">{t.labels.jumpTo}</h2>
      <ul class="mt-4 flex flex-wrap gap-3">
        {
          related.map((item) => (
            <li>
              <a class="focus-ring inline-flex rounded-full border border-[#17352a]/15 px-4 py-2 text-sm font-bold hover:bg-[#17352a] hover:text-white" href={item.href}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</article>
