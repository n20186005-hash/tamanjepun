---
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section id="faq" class="py-16 lg:py-24">
  <div class="mx-auto max-w-5xl px-5 lg:px-8">
    <div class="text-center">
      <p class="text-xs font-black uppercase tracking-[.24em] text-[#a63d2f]">{t.faq.eyebrow}</p>
      <h2 class="serif mt-4 text-4xl font-bold sm:text-5xl">{t.faq.h2}</h2>
    </div>
    <div class="mt-10 space-y-3">
      {
        t.faq.items.map((item) => (
          <details class="group rounded-2xl border border-[#17352a]/10 bg-white p-5 open:card-shadow">
            <summary class="cursor-pointer list-none pr-8 font-black marker:hidden">
              {item.q}<span class="float-right text-[#a63d2f] transition group-open:rotate-45">＋</span>
            </summary>
            <p class="mt-4 max-w-3xl text-sm leading-7 text-[#17352a]/68">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
