---
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section class="px-5 pb-16 lg:px-8 lg:pb-24">
  <div class="mx-auto max-w-7xl overflow-hidden rounded-[2.5rem] bg-[#a63d2f] p-8 text-white sm:p-12 lg:p-16">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-end">
      <div>
        <p class="text-xs font-black uppercase tracking-[.24em] text-white/65">{t.closing.eyebrow}</p>
        <h2 class="serif mt-4 max-w-4xl text-4xl font-bold sm:text-5xl">{t.closing.h2}</h2>
        <p class="mt-5 max-w-2xl leading-7 text-white/75">{t.closing.text}</p>
      </div>
      <a href="#atas" class="focus-ring inline-flex h-14 w-14 items-center justify-center rounded-full bg-white text-2xl font-black text-[#a63d2f]">↑</a>
    </div>
  </div>
</section>
