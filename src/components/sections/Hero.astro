---
import { FACTS } from '../../data/site';
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section class="relative min-h-[92vh] overflow-hidden bg-[#17352a] text-white">
  <img
    src={FACTS.images.garden.src}
    alt={t.hero.imageAlt}
    class="absolute inset-0 h-full w-full object-cover object-center"
    width="1000"
    height="667"
    decoding="async"
  />
  <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(18,45,34,.94)_0%,rgba(18,45,34,.68)_42%,rgba(18,45,34,.18)_100%)]"></div>
  <div class="absolute inset-y-0 right-5 hidden items-center lg:flex">
    <span class="vertical-mark text-xs font-bold uppercase text-white/55">{t.hero.strip}</span>
  </div>

  <div class="relative mx-auto flex min-h-[92vh] max-w-7xl items-end px-5 pb-20 pt-32 lg:px-8 lg:pb-28">
    <div class="max-w-3xl">
      <div class="mb-6 flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[.2em] backdrop-blur">{t.hero.badge}</span>
        <span class="inline-flex items-center gap-2 rounded-full bg-[#d8bc7a] px-4 py-2 text-xs font-bold text-[#17352a]">{t.hero.rating}</span>
      </div>
      <h1 class="serif text-5xl font-bold leading-[.98] tracking-tight sm:text-6xl lg:text-8xl">
        {t.hero.h1Lead}<br /><span class="text-[#d8bc7a]">{t.hero.h1Accent}</span>
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8 text-white/82 sm:text-xl">{t.hero.lede}</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="#rancang" class="focus-ring rounded-full bg-[#f5f0e5] px-6 py-3 text-sm font-extrabold text-[#17352a] hover:bg-white">{t.hero.ctaPlan}</a>
        <a href="#peta" class="focus-ring rounded-full border border-white/30 px-6 py-3 text-sm font-extrabold text-white hover:bg-white/10">{t.hero.ctaMap}</a>
      </div>
      <div class="mt-12 grid max-w-2xl grid-cols-2 gap-px overflow-hidden rounded-2xl border border-white/15 bg-white/15 sm:grid-cols-4">
        {
          t.hero.stats.map((stat) => (
            <div class="bg-[#17352a]/80 p-4 backdrop-blur">
              <div class="text-xs uppercase tracking-wider text-white/55">{stat.label}</div>
              <div class="mt-1 font-bold">{stat.value}</div>
              {stat.note ? <div class="text-xs text-white/55">{stat.note}</div> : <div class="text-xs text-white/55">&nbsp;</div>}
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
