---
import { FACTS } from '../../data/site';
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section class="py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[.9fr_1.1fr]">
      <div>
        <p class="text-xs font-black uppercase tracking-[.24em] text-[#a63d2f]">{t.nearby.eyebrow}</p>
        <h2 class="serif mt-4 text-4xl font-bold sm:text-5xl">{t.nearby.h2}</h2>
        <p class="mt-5 max-w-xl leading-7 text-[#17352a]/70">{t.nearby.intro}</p>
      </div>
      <div>
        <figure class="mb-5 overflow-hidden rounded-[2rem] bg-[#17352a] text-white card-shadow">
          <img
            src={FACTS.images.colmar.src}
            alt={t.nearby.items[0].name}
            width="800"
            height="533"
            loading="lazy"
            class="aspect-[16/8] w-full object-cover"
          />
          <figcaption class="p-5 text-sm text-white/70">{t.nearby.caption}</figcaption>
        </figure>
        <div class="space-y-4">
          {
            t.nearby.items.map((place) => (
              <article class="group rounded-3xl border border-[#17352a]/10 bg-white p-6 transition hover:-translate-y-0.5">
                <div class="flex flex-wrap items-baseline justify-between gap-2">
                  <h3 class="text-xl font-black">{place.name}</h3>
                  <span class="text-xs font-black uppercase tracking-[.16em] text-[#a63d2f]">{place.meta}</span>
                </div>
                <p class="mt-3 text-sm leading-6 text-[#17352a]/66">{place.note}</p>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
