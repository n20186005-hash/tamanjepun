---
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section id="rancang" class="bg-[#efe8da] py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="max-w-3xl">
      <p class="text-xs font-black uppercase tracking-[.24em] text-[#a63d2f]">{t.plan.eyebrow}</p>
      <h2 class="serif mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{t.plan.h2}</h2>
    </div>

    <div class="mt-10 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {
        t.plan.cards.map((card) => (
          <article class="rounded-3xl border border-[#17352a]/10 bg-white/70 p-6">
            <span class="text-3xl">{card.icon}</span>
            <h3 class="mt-8 text-xl font-black">{card.title}</h3>
            <p class="mt-3 text-sm leading-6 text-[#17352a]/70">{card.text}</p>
          </article>
        ))
      }
    </div>

    <div class="mt-10 grid gap-6 lg:grid-cols-2">
      <article class="rounded-[2rem] bg-white p-7 card-shadow sm:p-9">
        <div class="flex items-start justify-between gap-6">
          <div>
            <p class="text-xs font-black uppercase tracking-[.2em] text-[#a63d2f]">{t.plan.tickets.eyebrow}</p>
            <h3 class="serif mt-3 text-3xl font-bold">{t.plan.tickets.h3}</h3>
          </div>
          <span class="rounded-full bg-[#efe8da] px-4 py-2 text-sm font-black">{t.plan.tickets.badge}</span>
        </div>
        <dl class="mt-5 divide-y divide-[#17352a]/10 text-sm">
          {
            t.plan.tickets.rows.map((row) => (
              <div class="flex items-baseline justify-between gap-4 py-3">
                <dt class="font-bold">{row.label}</dt>
                <dd class="text-[#17352a]/70">{row.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="mt-5 leading-7 text-[#17352a]/72">{t.plan.tickets.note}</p>
        <p class="mt-4 text-sm leading-6 text-[#17352a]/55">{t.plan.tickets.disclaimer}</p>
      </article>

      <article class="rounded-[2rem] bg-[#294f3c] p-7 text-white card-shadow sm:p-9">
        <p class="text-xs font-black uppercase tracking-[.2em] text-[#d8bc7a]">{t.plan.parking.eyebrow}</p>
        <h3 class="serif mt-3 text-3xl font-bold">{t.plan.parking.h3}</h3>
        <p class="mt-5 leading-7 text-white/76">{t.plan.parking.text}</p>
        <ul class="mt-5 space-y-2 text-sm text-white/75">
          {t.plan.parking.tips.map((tip) => <li>• {tip}</li>)}
        </ul>
      </article>
    </div>
  </div>
</section>
