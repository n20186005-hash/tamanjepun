---
import { FACTS } from '../../data/site';
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section class="paper-grid border-b border-[#17352a]/10 py-16 lg:py-24">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 lg:grid-cols-[1.05fr_.95fr] lg:px-8">
    <div>
      <p class="text-xs font-black uppercase tracking-[.24em] text-[#a63d2f]">{t.about.eyebrow}</p>
      <h2 class="serif mt-4 text-4xl font-bold tracking-tight sm:text-5xl">{t.about.h2}</h2>
      {t.about.paras.map((p) => <p class="mt-6 max-w-2xl text-lg leading-8 text-[#17352a]/75">{p}</p>)}
      <div class="mt-8 flex gap-4 border-l-2 border-[#a63d2f] pl-5 text-sm leading-7 text-[#17352a]/70">
        <strong class="text-[#17352a]">{t.about.calloutLabel}</strong>
        <span>{t.about.calloutText}</span>
      </div>
    </div>
    <figure class="relative">
      <img
        src={FACTS.images.view.src}
        alt={t.about.h2}
        class="card-shadow aspect-[4/3] w-full rounded-[2rem] object-cover"
        width="1000"
        height="667"
        loading="lazy"
      />
      <figcaption class="mt-3 text-xs text-[#17352a]/55">{t.about.caption}</figcaption>
    </figure>
  </div>
</section>
