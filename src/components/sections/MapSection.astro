---
import { FACTS } from '../../data/site';
import type { Content } from '../../content/types';

const { t } = Astro.props as { t: Content };
---

<section id="peta" class="bg-[#efe8da] py-16 lg:py-24">
  <div class="mx-auto max-w-7xl px-5 lg:px-8">
    <div class="grid gap-8 lg:grid-cols-[.68fr_1.32fr] lg:items-center">
      <div>
        <p class="text-xs font-black uppercase tracking-[.24em] text-[#a63d2f]">{t.map.eyebrow}</p>
        <h2 class="serif mt-4 text-4xl font-bold sm:text-5xl">{t.map.h2}</h2>
        <p class="mt-5 leading-7 text-[#17352a]/70">{t.map.intro}</p>
        <p class="mt-4 text-sm font-bold text-[#17352a]">
          {t.map.addressLabel}: {FACTS.address.streetAddress}, {FACTS.address.postalCode} {FACTS.address.addressLocality}, {FACTS.address.addressRegion}
        </p>
        <a
          href={FACTS.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="focus-ring mt-7 inline-flex rounded-full bg-[#17352a] px-5 py-3 text-sm font-black text-white hover:bg-[#294f3c]"
        >
          {t.map.cta}
        </a>
      </div>
      <div class="overflow-hidden rounded-[2rem] border border-[#17352a]/10 bg-white p-2 card-shadow">
        <iframe
          title={t.map.h2}
          src={FACTS.mapsEmbedUrl}
          width="600"
          height="450"
          style="border:0;"
          allowfullscreen
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          class="min-h-[460px] w-full rounded-[1.55rem]"
        ></iframe>
      </div>
    </div>
  </div>
</section>
