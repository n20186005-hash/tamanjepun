---
import '../styles/global.css';
import { FACTS } from '../data/site';
import { locales, localeMeta, pathFor, alternatesFor, type Locale, type RouteKey } from '../i18n';
import ms from '../content/ms';
import en from '../content/en';
import zh from '../content/zh';
import type { Content } from '../content/types';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';

const contents: Record<Locale, Content> = { ms, en, zh };

interface Props {
  locale: Locale;
  route: RouteKey;
  title: string;
  description: string;
  ogImage?: string;
  jsonLd?: unknown[];
  preloadImage?: string;
}

const { locale, route, title, description, ogImage = FACTS.images.garden.src, jsonLd = [], preloadImage } = Astro.props;

const t = contents[locale];
const site = Astro.site;
const path = pathFor(route, locale);
const meta = localeMeta[locale];

const canonical = site ? new URL(path, site).toString() : undefined;
const alternates = site
  ? alternatesFor(route).map((alt) => ({ hreflang: alt.hreflang, href: new URL(alt.path, site).toString() }))
  : [];
const ogImageUrl = site ? new URL(ogImage, site).toString() : ogImage;
const otherLocales = locales.filter((l) => l !== locale);
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#17352a" />
    <meta name="description" content={description} />
    <title>{title}</title>
    {canonical && <link rel="canonical" href={canonical} />}
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {site && <link rel="sitemap" href={new URL('/sitemap-index.xml', site).toString()} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Taman Jepun Bukit Tinggi" />
    <meta property="og:locale" content={meta.ogLocale} />
    {otherLocales.map((l) => <meta property="og:locale:alternate" content={localeMeta[l].ogLocale} />)}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:alt" content={t.hero.imageAlt} />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="667" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link rel="icon" type="image/svg+xml" href="/brand/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/brand/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon.png" />
    {preloadImage && <link rel="preload" as="image" href={preloadImage} />}

    {jsonLd.map((schema) => <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>)}

    <script async src={`https://www.googletagmanager.com/gtag/js?id=${FACTS.gaId}`}></script>
    <script is:inline define:vars={{ gaId: FACTS.gaId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
  </head>
  <body>
    <SiteHeader locale={locale} route={route} t={t} />
    <slot />
    <SiteFooter locale={locale} route={route} t={t} />
  </body>
</html>
